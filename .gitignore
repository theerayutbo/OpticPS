# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/
.coverage

# Local agent/tool state
.omc/
.claude/
.DS_Store

# Copyrighted papers are cited, never redistributed
*.pdf
!reports/OpticPS_Research_Report.pdf
!reports/Fiber_Model_Validation_Report.pdf
!reports/UXR_Receiver_Analysis_Example.pdf
!slides/OpticPS_Research_Presentation.pdf

# Saved eye data of the committed example (about 1 MB each); scripts/make_uxr_example.py recreates it
results/uxr_example/*_eye.npz

# Private laboratory data must never be committed
data/private/*
!data/private/README.md

# Externally sourced datasets and source-data assets are cited, never vendored
data/external/

# Secrets
.env
*.pem
*.key
